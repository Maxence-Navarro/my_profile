# Copier en .env.local. Ne jamais committer de vraies clés.

# Secret servant à signer le cookie de session de démonstration (32+ caractères aléatoires).
SESSION_SECRET=change-me-to-a-long-random-string

# Mode d'accès : "demo" (bouton pour simuler un compte premium, aucun paiement)
# ou "off" (tout le contenu premium reste verrouillé).
ACCESS_MODE=demo

# Paiement — NON ACTIVÉ dans la V1. Laisser vide.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Base PostgreSQL (facultative en V1 : le site lit data/published/*.json)
DATABASE_URL=postgres://localhost:5432/bac_ses
