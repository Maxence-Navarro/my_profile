{
  "name": "bac-ses-revision",
  "version": "0.1.0",
  "private": true,
  "description": "Plateforme de révision du bac SES (Terminale) — sujets officiels, grilles, corrigés",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "data:build": "python3 -I pipeline/build.py",
    "data:qa": "python3 -I pipeline/qa.py",
    "db:import": "tsx scripts/import-to-postgres.ts"
  },
  "dependencies": {
    "marked": "^16.2.1",
    "next": "15.5.27",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@tailwindcss/postcss": "4.1.13",
    "@tailwindcss/typography": "0.5.16",
    "@types/node": "22.18.1",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "pg": "8.16.3",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
